{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-buscador-ir.local/schemas/metadata_schema.json",
  "title": "Corpus Planning Metadata Schema",
  "description": "Esquema de validación para documents.json, categories.json y links.json del corpus de Recuperación de Información (10 categorías, sin subcategorías).",
  "type": "object",
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "id",
        "title",
        "filename",
        "category_id",
        "category_code",
        "category",
        "slug",
        "path",
        "description",
        "tags",
        "document_type",
        "hub_ids",
        "planned_links",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "filename": {
          "type": "string",
          "pattern": "^D[0-9]{3,}_[a-z0-9_]+\\.html$"
        },
        "category_id": {
          "type": "string",
          "pattern": "^C(0[1-9]|10)$"
        },
        "category_code": {
          "type": "string",
          "pattern": "^(0[1-9]|10)$"
        },
        "category": {
          "type": "string",
          "minLength": 3
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^data/corpus/[0-9]{2}_[a-z0-9_]+/D[0-9]{3,}_[a-z0-9_]+\\.html$"
        },
        "description": {
          "type": "string",
          "minLength": 50
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "document_type": {
          "type": "string",
          "enum": [
            "category_hub",
            "specialized"
          ]
        },
        "hub_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{3,}$"
          }
        },
        "planned_links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{3,}$"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "created"
          ]
        }
      }
    },
    "category": {
      "type": "object",
      "required": [
        "category_id",
        "code",
        "name",
        "dir_name",
        "description",
        "tags",
        "related_categories",
        "category_hub_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "type": "string",
          "pattern": "^C(0[1-9]|10)$"
        },
        "code": {
          "type": "string",
          "pattern": "^(0[1-9]|10)$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "dir_name": {
          "type": "string",
          "pattern": "^(0[1-9]|10)_[a-z0-9_]+$"
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "related_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C(0[1-9]|10)$"
          }
        },
        "category_hub_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{3,}$"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "source_id",
        "target_id",
        "relation_type",
        "justification"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^D[0-9]{3,}$"
        },
        "target_id": {
          "type": "string",
          "pattern": "^D[0-9]{3,}$"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "category_navigation",
            "related_concept",
            "prerequisite",
            "implementation",
            "architecture_relation",
            "security_relation",
            "comparison"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 15
        }
      }
    }
  }
}
