{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-buscador-ir.local/schemas/metadata_schema.json",
  "title": "Corpus Planning Metadata Schema",
  "description": "Esquema de validación para documents.json, categories.json y links.json del corpus de 500 documentos.",
  "type": "object",
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category_id",
        "category_code",
        "category",
        "subcategory_id",
        "subcategory_code",
        "subcategory",
        "slug",
        "path",
        "description",
        "tags",
        "document_type",
        "hub_ids",
        "planned_links",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D(00[1-9]|0[1-9][0-9]|[1-4][0-9]{2}|500)$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "category_id": {
          "type": "string",
          "pattern": "^C(0[1-9]|10)$"
        },
        "category_code": {
          "type": "string",
          "pattern": "^(0[1-9]|10)$"
        },
        "category": {
          "type": "string",
          "minLength": 3
        },
        "subcategory_id": {
          "type": "string",
          "pattern": "^C(0[1-9]|10)\\.[1-5]$"
        },
        "subcategory_code": {
          "type": "string",
          "pattern": "^(0[1-9]|10)\\.[1-5]$"
        },
        "subcategory": {
          "type": "string",
          "minLength": 3
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^data/corpus/[0-9]{2}_[a-z0-9_]+/[0-9]{2}_[a-z0-9_]+/D[0-9]{3}_[a-z0-9_]+\\.html$"
        },
        "description": {
          "type": "string",
          "minLength": 100
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "document_type": {
          "type": "string",
          "enum": [
            "category_hub",
            "subcategory_hub",
            "reference",
            "specialized"
          ]
        },
        "hub_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{3}$"
          }
        },
        "planned_links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{3}$"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "drafted",
            "reviewed",
            "published"
          ]
        }
      }
    },
    "subcategory": {
      "type": "object",
      "required": [
        "subcategory_id",
        "code",
        "name",
        "dir_name",
        "id_range",
        "hub_id"
      ],
      "additionalProperties": false,
      "properties": {
        "subcategory_id": {
          "type": "string",
          "pattern": "^C(0[1-9]|10)\\.[1-5]$"
        },
        "code": {
          "type": "string",
          "pattern": "^(0[1-9]|10)\\.[1-5]$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "dir_name": {
          "type": "string",
          "pattern": "^[0-9]{2}_[a-z0-9_]+$"
        },
        "id_range": {
          "type": "string",
          "pattern": "^D[0-9]{3}-D[0-9]{3}$"
        },
        "hub_id": {
          "type": "string",
          "pattern": "^D[0-9]{3}$"
        }
      }
    },
    "category": {
      "type": "object",
      "required": [
        "category_id",
        "code",
        "name",
        "dir_name",
        "id_range",
        "description",
        "tags",
        "related_categories",
        "category_hub_ids",
        "subcategories"
      ],
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "type": "string",
          "pattern": "^C(0[1-9]|10)$"
        },
        "code": {
          "type": "string",
          "pattern": "^(0[1-9]|10)$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "dir_name": {
          "type": "string",
          "pattern": "^[0-9]{2}_[a-z0-9_]+$"
        },
        "id_range": {
          "type": "string",
          "pattern": "^D[0-9]{3}-D[0-9]{3}$"
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "related_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C(0[1-9]|10)$"
          }
        },
        "category_hub_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{3}$"
          }
        },
        "subcategories": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/subcategory"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "source_id",
        "target_id",
        "relation_type",
        "justification"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^D[0-9]{3}$"
        },
        "target_id": {
          "type": "string",
          "pattern": "^D[0-9]{3}$"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "intra_subcategory",
            "related_concept",
            "category_navigation",
            "prerequisite",
            "implementation",
            "comparison",
            "security_relation",
            "architecture_relation"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  },
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 500,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  }
}
